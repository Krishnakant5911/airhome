<% layout("/layouts/boilerplate") %>
<div class="row mt-3">
    <div class="col-8 offset-3">
        <h3> <%= allListing.title %></h3>
    </div>
    <div class="card col-6 offset-3 listing-card " style="width: 30rem;">
        <img src="<%= allListing.image %>" class="card-img-top" alt="listing_image">
        <div class="card-body">
            <p class="card-text">  <%= allListing.description %> <br>
                &#x20B9; <%= allListing.price.toLocaleString("en-IN") %> <br>
                <%= allListing.location %> <br>
                <%= allListing.country %>
            </p>
        </div>
    </div>
    <div class="btns mb-3">
        <a href="/listings/<%=allListing._id %>/edit" class="btn btn-dark col-1 offset-3 edit-btn">Edit</a>
        <form method="POST" action="/listings/<%= allListing._id %>?_method=DELETE">
            <button class="btn btn-dark offset-4">Delete</button>
        </form>
    </div>
    <div class="col-8 offset-3 mb-3" >
        <hr>
        <h4> Leave a Review</h4>
        <form action="/listings/<%=allListing._id %>/reviews" method="post" novalidate class="needs-validation">
            <div class="mt-3 mb-3" >
                <label for="rating" class="form-label">Rating</label>
                <input type="range" min="1" max="5" id="rating" name="review[rating]" class="form-range">
            </div>
            <div class="mt-3 mb-3">
                <label for="comment" class="form-label">Comments</label>
                <textarea name="review[comment]" id="comment" cols="30" rows="5" class="form-control" required></textarea>
                <div class="invalid-feedback">
                    please provide a short Comments
                </div>
            </div>
            <button class="btn btn-outline-dark">Submit</button>
        </form>
        <hr>
        <p> <b>All Reviews</b></p>
        
       <div class="row">
            <% for(let review of allListing.reviews) { %>
               <div class="card col-5 ms-3 mb-3">
                <div class="card-body">
                    <h5 class="card-title"> krishna</h5>
                    <p class="card-text"> <%= review.comment %></p>
                    <p class="card-text"> <%= review.rating %> &#9733;</p>
                </div>
                <form method="POST" action="/listings/<%=allListing._id %>/reviews/<%= review._id %>?_method=DELETE">
                    <button class="btn btn-sm btn-dark mb-3 ">Delete</button>
                </form>
               </div>
            <% } %>
       </div>
        
    </div>
</div>