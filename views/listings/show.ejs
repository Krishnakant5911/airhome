<% layout("/layouts/boilerplate") %>
<div class="row mt-3">
    <div class="col-8 offset-2">
        <h3>Listing Details:</h3>
    </div>
    <div class="card col-6 offset-2" style="width: 30rem;">
        <img src="<%= allListing.image %>" class="card-img-top" alt="listing_image">
        <div class="card-body">
            <p class="card-text"> <b> <%= allListing.title %> </b></p>
            <p class="card-text">  <%= allListing.description %> <br>
                &#x20B9; <%= allListing.price.toLocaleString("en-IN") %> <br>
                <%= allListing.location %> <br>
                <%= allListing.country %>
            </p>
        </div>
    </div>
    <div class="btns mb-3">
        <a href="/listings/<%=allListing._id %>/edit" class="btn btn-dark col-1 offset-2 edit-btn">Edit</a>
        <form method="POST" action="/listings/<%= allListing._id %>?_method=DELETE">
            <button class="btn btn-dark offset-4">Delete</button>
        </form>
    </div>
</div>